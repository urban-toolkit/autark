{
  "name": "@urban-toolkit/autk",
  "version": "4.0.0",
  "keywords": [
    "urban",
    "visualization",
    "analytics",
    "WebGPU"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/urban-toolkit/autark",
    "directory": "autk"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js",
      "default": "./dist/map.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "default": "./dist/db.js"
    },
    "./compute": {
      "types": "./dist/compute.d.ts",
      "import": "./dist/compute.js",
      "default": "./dist/compute.js"
    },
    "./plot": {
      "types": "./dist/plot.d.ts",
      "import": "./dist/plot.js",
      "default": "./dist/plot.js"
    }
  },
  "scripts": {
    "dev-build": "tsc && vite build --watch",
    "build": "tsc && vite build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@urban-toolkit/autk-core": "4.0.0",
    "@urban-toolkit/autk-map": "4.0.0",
    "@urban-toolkit/autk-db": "4.0.0",
    "@urban-toolkit/autk-compute": "4.0.0",
    "@urban-toolkit/autk-plot": "4.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
