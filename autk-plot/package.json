{
  "name": "@urban-toolkit/autk-plot",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/urban-toolkit/autark",
    "directory": "autk-plot"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/autk-plot.umd.cjs",
  "module": "./dist/autk-plot.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/autk-plot.js",
      "require": "./dist/autk-plot.umd.cjs",
      "default": "./dist/autk-plot.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev-build": "tsc && vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "doc": "typedoc --options typedoc.json",
    "doc:watch": "typedoc --options typedoc.json --watch"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "ts-loader": "^9.6.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-theme-oxide": "^0.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@turf/turf": "^7.3.5",
    "@urban-toolkit/autk-core": "4.0.0",
    "d3": "^7.9.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3"
  }
}
