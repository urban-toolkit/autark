{
  "name": "@urban-toolkit/autk-map",
  "version": "4.1.0",
  "keywords": [
    "visualization",
    "urban",
    "3D"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/urban-toolkit/autark",
    "directory": "autk-map"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/autk-map.umd.cjs",
  "module": "./dist/autk-map.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/autk-map.js",
      "require": "./dist/autk-map.umd.cjs",
      "default": "./dist/autk-map.js"
    }
  },
  "scripts": {
    "doc": "typedoc --options typedoc.json",
    "dev": "vite",
    "dev-build": "tsc && vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.16",
    "@webgpu/types": "^0.1.74",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-glsl": "^1.6.2"
  },
  "dependencies": {
    "@urban-toolkit/autk-core": "4.1.0",
    "d3": "^7.9.0"
  }
}
