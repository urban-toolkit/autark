{
  "name": "@urban-toolkit/autk-map",
  "version": "4.0.0",
  "keywords": [
    "visualization",
    "urban",
    "3D"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/urban-toolkit/autark",
    "directory": "autk-map"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/autk-map.umd.cjs",
  "module": "./dist/autk-map.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/autk-map.js",
      "require": "./dist/autk-map.umd.cjs",
      "default": "./dist/autk-map.js"
    }
  },
  "scripts": {
    "doc": "typedoc --options typedoc.json",
    "dev": "vite",
    "dev-build": "tsc && vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@webgpu/types": "^0.1.71",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "ts-loader": "^9.6.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-theme-oxide": "^0.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-glsl": "^1.6.0"
  },
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "@urban-toolkit/autk-core": "4.0.0",
    "d3": "^7.9.0",
    "earcut": "^3.2.3",
    "gl-matrix": "^3.4.4",
    "poly-extrude": "^0.22.2"
  }
}
