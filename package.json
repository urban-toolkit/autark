{
  "name": "autark",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "benchmark": "npm --workspace=benchmark run benchmark",
    "benchmark:views": "npm --workspace=benchmark run benchmark:views",
    "benchmark:synthetic": "npm --workspace=benchmark run benchmark:synthetic",
    "benchmark:spatialbench": "npm --workspace=benchmark run benchmark:spatialbench",
    "validate:packages": "node .github/scripts/validate-packages.mjs"
  },
  "workspaces": [
    "autk",
    "autk-core",
    "autk-db",
    "autk-map",
    "autk-compute",
    "autk-plot",
    "gallery",
    "usecases",
    "benchmark"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "vitest": "^5.0.0"
  }
}
