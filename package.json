{
    "name": "autark",
    "private": true,
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "validate:specs": "ajv validate -s schema/autark-spec-v0.1.json -d \"examples/specs/*.json\" --strict=false",
        "test:runtime": "playwright test tests/runtime --workers=1"
    },
    "workspaces": [
        "autk",
        "autk-core",
        "autk-db",
        "autk-map",
        "autk-compute",
        "autk-plot",
        "autk-runtime",
        "gallery",
        "usecases"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.59.1",
        "@types/node": "^25.6.0",
        "@typescript-eslint/eslint-plugin": "^8.58.1",
        "@typescript-eslint/parser": "^8.58.1",
        "ajv": "^8.20.0",
        "ajv-cli": "^5.0.0",
        "eslint": "^10.1.0",
        "globals": "^17.4.0"
    }
}
