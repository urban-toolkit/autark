{
  "$schema": "https://urban-toolkit.github.io/autark/schema/autark-spec-v0.1.json",
  "version": "0.1",
  "metadata": {
    "title": "GeoTIFF Raster Example",
    "description": "Example demonstrating GeoTIFF raster data loading and visualization"
  },
  "workspace": {
    "name": "raster_example",
    "coordinateFormat": "EPSG:4326"
  },
  "data": [
    {
      "type": "geotiff",
      "name": "temperature",
      "url": "https://example.com/data/land_surface_temperature.tif",
      "band": 1
    }
  ],
  "views": [
    {
      "id": "map",
      "type": "map",
      "title": "Land Surface Temperature",
      "layers": [
        {
          "id": "temp_layer",
          "source": "temperature",
          "type": "raster",
          "encoding": {
            "color": {
              "field": "value",
              "scale": {
                "domain": [0, 50],
                "range": ["blue", "red"]
              }
            }
          }
        }
      ],
      "viewport": {
        "center": [-73.935, 40.730],
        "zoom": 10
      }
    }
  ]
}