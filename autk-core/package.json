{
  "name": "@urban-toolkit/autk-core",
  "version": "4.0.0",
  "description": "Shared runtime utilities for the Autark toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/urban-toolkit/autark",
    "directory": "autk-core"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/autk-core.umd.cjs",
  "module": "./dist/autk-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/autk-core.js",
      "require": "./dist/autk-core.umd.cjs",
      "default": "./dist/autk-core.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev-build": "tsc && vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "doc": "typedoc --options typedoc.json"
  },
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "d3-color": "^3.1.0",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "earcut": "^3.2.3",
    "gl-matrix": "^3.4.4",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/rbush": "^4.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-theme-oxide": "^0.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3"
  }
}
