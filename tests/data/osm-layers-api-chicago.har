a. The challenging character and lush feeling of this historic condition is in dramatic\"\n  }\n},\n{\n  \"type\": \"way\",\n  \"id\": 771241208,\n  \"bounds\": {\n    \"minlat\": 41.8811736,\n    \"minlon\": -87.6217974,\n    \"maxlat\": 41.8813102,\n    \"maxlon\": -87.6214034\n  },\n  \"nodes\": [\n    7199605473,\n    7199605478,\n    7199605476,\n    1406189030,\n    1406189035,\n    7199605473\n  ],\n  \"geometry\": [\n    { \"lat\": 41.8812667, \"lon\": -87.6217483 },\n    { \"lat\": 41.8811736, \"lon\": -87.6217974 },\n    { \"lat\": 41.8811774, \"lon\": -87.6214518 },\n    { \"lat\": 41.8812259, \"lon\": -87.6214312 },\n    { \"lat\": 41.8813102, \"lon\": -87.6214034 },\n    { \"lat\": 41.8812667, \"lon\": -87.6217483 }\n  ],\n  \"tags\": {\n    \"landuse\": \"meadow\",\n    \"name\": \"East Meadow\"\n  }\n},\n{\n  \"type\": \"way\",\n  \"id\": 1053110449,\n  \"bounds\": {\n    \"minlat\": 41.8825906,\n    \"minlon\": -87.6289902,\n    \"maxlat\": 41.8831593,\n    \"maxlon\": -87.6279909\n  },\n  \"nodes\": [\n    9678129055,\n    9678129056,\n    9678129057,\n    1388390373,\n    1388390372,\n    11060274237,\n    9678129058,\n    9678129059,\n    9710044179,\n    9678129055\n  ],\n  \"geometry\": [\n    { \"lat\": 41.8825906, \"lon\": -87.6289902 },\n    { \"lat\": 41.8831593, \"lon\": -87.6289837 },\n    { \"lat\": 41.8831579, \"lon\": -87.6284059 },\n    { \"lat\": 41.8829662, \"lon\": -87.6283950 },\n    { \"lat\": 41.8829675, \"lon\": -87.6280879 },\n    { \"lat\": 41.8829630, \"lon\": -87.6280707 },\n    { \"lat\": 41.8829641, \"lon\": -87.6279996 },\n    { \"lat\": 41.8825926, \"lon\": -87.6279909 },\n    { \"lat\": 41.8825925, \"lon\": -87.6280397 },\n    { \"lat\": 41.8825906, \"lon\": -87.6289902 }\n  ],\n  \"tags\": {\n    \"landuse\": \"residential\"\n  }\n},\n{\n  \"type\": \"way\",\n  \"id\": 1053110450,\n  \"bounds\": {\n    \"minlat\": 41.8829630,\n    \"minlon\": -87.6284059,\n    \"maxlat\": 41.8831579,\n    \"maxlon\": -87.6279996\n  },\